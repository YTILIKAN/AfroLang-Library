# Copier vers backend-api/.env et ajuster si besoin.
# Démarrer Postgres : docker compose up -d postgres

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/afriland

# Sécurité (production : valeur aléatoire longue)
AUTH_SECRET_KEY=dev-change-me-in-production

# CORS — URL du frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Catalogue
CATALOG_STUB=false
# Jeu de datasets de démonstration — mettre a false en production
CATALOG_AUTO_SEED=false
# Ingestion au demarrage, source par source : une source est passee seulement si elle a
# a la fois une ingestion reussie tracee et des datasets synchronises en base.
# Garantit qu'une base vierge (prod, nouveau volume) se peuple seule, et qu'une source
# restee vide (echec reseau, identifiants absents, catalogue purge) est reprise au
# demarrage suivant sans reingerer les autres.
CATALOG_BOOTSTRAP_INGEST=true
AFRILANG_AUTO_SEED=true
ACCOUNTS_STUB=false

# Compte admin initial (créé au démarrage si aucun admin en base)
ACCOUNTS_AUTO_SEED=true
ADMIN_SEED_EMAIL=admin@afriland.org
ADMIN_SEED_PASSWORD=admin123
ADMIN_SEED_DISPLAY_NAME=Admin AfroLang

# Optionnel — ingestion Kaggle
# KAGGLE_USERNAME=
# KAGGLE_KEY=
