# Copier vers backend-api/.env et ajuster si besoin.
# Démarrer Postgres : docker compose up -d postgres

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/afriland

# Sécurité (production : valeur aléatoire longue)
AUTH_SECRET_KEY=dev-change-me-in-production

# CORS — URL du frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Catalogue
CATALOG_STUB=false
CATALOG_AUTO_SEED=true
ACCOUNTS_STUB=false

# Optionnel — ingestion Kaggle
# KAGGLE_USERNAME=
# KAGGLE_KEY=
